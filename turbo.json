{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
		},
		"lint": {
			"inputs": ["$TURBO_DEFAULT$", "biome.json"]
		},
		"format": {
			"inputs": ["$TURBO_DEFAULT$", "biome.json"]
		},
		"check": {
			"inputs": ["$TURBO_DEFAULT$", "biome.json"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "bunfig.toml", "test/**"],
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false
		},
		"db:push": {
			"cache": false
		}
	}
}
