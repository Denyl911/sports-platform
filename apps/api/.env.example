# ─── Auth / JWT ───────────────────────────────────────────────
JWT_ACCESS_SECRET=         # openssl rand -hex 32
JWT_REFRESH_SECRET=        # openssl rand -hex 32

# ─── Server ───────────────────────────────────────────────────
NODE_ENV=development       # development | production | test
PORT=3000                  # Puerto HTTP
CORS_ALLOWED_ORIGINS=      # En producción, separar por comas. Ej: https://app.midominio.com

# ─── S3 / Object Storage (MinIO, AWS S3, etc.) ───────────────
S3_ENDPOINT=http://localhost:9000   # URL del servicio S3 (MinIO en local)
S3_REGION=us-east-1                  # Región S3
S3_BUCKET=sports-platform-dev       # Bucket por defecto
S3_PUBLIC_URL=                      # URL pública base (opcional). Default: ${S3_ENDPOINT}/${S3_BUCKET}
S3_ACCESS_KEY_ID=minioadmin         # Access Key (compat: S3_ACCESS_KEY)
S3_SECRET_ACCESS_KEY=minioadmin     # Secret Key (compat: S3_SECRET_KEY)
