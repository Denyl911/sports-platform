{
	"name": "@sports/ui",
	"version": "0.0.1",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./components/*": "./src/components/*.tsx",
		"./lib/*": "./src/lib/*.ts",
		"./styles.css": {
			"style": "./src/styles.css",
			"default": "./src/styles.css"
		},
		"./src/styles.css": {
			"style": "./src/styles.css",
			"default": "./src/styles.css"
		}
	},
	"scripts": {
		"lint": "biome lint --write",
		"format": "biome format --write",
		"check": "biome check --write",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"lucide-react": "^1.59.0",
		"motion": "^14.3.0",
		"tailwind-merge": "^3.6.0"
	},
	"peerDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@sports/tsconfig": "workspace:*",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"tailwindcss": "^4.3.3"
	}
}
