{
	"name": "sports-platform",
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@types/bun": "^1.4.0",
		"turbo": "^2.10.11"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.0"
		}
	},
	"engines": {
		"node": ">=24"
	},
	"overrides": {
		"drizzle-orm": "1.0.0-rc.4"
	},
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"check": "turbo run check",
		"check-types": "turbo run typecheck",
		"test": "turbo run test",
		"layering": "bun scripts/checks.ts layering",
		"errors-check": "bun scripts/checks.ts errors",
		"rbac-check": "bun scripts/checks.ts rbac",
		"adr-check": "bun scripts/checks.ts adr",
		"docs-check": "bun scripts/checks.ts docs",
		"checks": "bun scripts/checks.ts gate",
		"gate": "bun scripts/checks.ts gate && turbo run check typecheck test"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"dependencies": {
		"lucide-react": "^1.59.0"
	}
}
